<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.langchain4j.cdi.mcp</groupId>
        <artifactId>langchain4j-cdi-mcp-integration-tests</artifactId>
        <version>1.5.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-cdi-mcp-integration-tests-helidon</artifactId>
    <name>Langchain4J CDI: MCP Integration Tests Helidon</name>

    <properties>
        <helidon.version>4.3.4</helidon.version>
        <skipITs>true</skipITs>
        <maven.compiler.source combine.self="override">21</maven.compiler.source>
        <maven.compiler.target combine.self="override">21</maven.compiler.target>
        <maven.compiler.release combine.self="override">21</maven.compiler.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Import langchain4j-bom first so its versions take precedence over Helidon's bundled langchain4j (1.6.0) -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${dev.langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.helidon</groupId>
                <artifactId>helidon-bom</artifactId>
                <version>${helidon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.helidon</groupId>
                <artifactId>helidon-dependencies</artifactId>
                <version>${helidon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.9.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-integration-tests-common</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-build-compatible-ext</artifactId>
        </dependency>
        <!--
            langchain4j-cdi-mcp-invoker-cdi41 is deliberately NOT on this classpath. Helidon 4.3.4 is a Jakarta EE 10
            / MicroProfile stack: it ships Weld 5.1.6 and weld-lite-extension-translator 5.1.6, which implement CDI
            4.0 and know nothing of jakarta.enterprise.invoke. Adding the module fails the deployment outright, in
            two different ways depending on which CDI API is resolved:
              - with cdi-api 4.0.1 (the inherited version): NoClassDefFoundError
                jakarta/enterprise/inject/build/compatible/spi/InvokerFactory while loading the extension;
              - with cdi-api 4.1.0 forced: LITE-EXTENSION-TRANSLATOR-000017 ... during phase @Registration ...
                NullPointerException: Cannot invoke "Object.equals(Object)" because "candidate.type" is null,
                because the 5.1.6 translator has no candidate for an InvokerFactory extension parameter.
            Both were reproduced on 2026-09-14; see docs/superpowers/plans/2026-09-14-mcp-invokers-cdi41.md.
            Revisit when Helidon moves to Weld 6 / Jakarta EE 11.
        -->
        <!-- Helidon -->
        <dependency>
            <groupId>io.helidon.microprofile.bundles</groupId>
            <artifactId>helidon-microprofile</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.jboss.logging</groupId>
                    <artifactId>jboss-logging-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.jboss.logging</groupId>
                    <artifactId>jboss-logging-processor</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.helidon.logging</groupId>
            <artifactId>helidon-logging-jul</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>io.helidon.microprofile.testing</groupId>
            <artifactId>helidon-microprofile-testing-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.1.8</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <!-- The injected WebTarget uses Jersey's HttpUrlConnection-based client, which silently drops
                         the "Origin" header unless this JDK-internal restriction is lifted; needed for the Origin
                         validation tests to exercise the real header. -->
                    <systemPropertyVariables>
                        <sun.net.http.allowRestrictedHeaders>true</sun.net.http.allowRestrictedHeaders>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
