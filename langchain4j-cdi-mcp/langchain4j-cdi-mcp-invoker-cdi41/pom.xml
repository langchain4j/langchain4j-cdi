<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.langchain4j.cdi.mcp</groupId>
        <artifactId>langchain4j-cdi-mcp</artifactId>
        <version>1.5.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-cdi-mcp-invoker-cdi41</artifactId>
    <name>Langchain4J CDI: MCP Server CDI 4.1 Invoker</name>
    <description>Optional add-on that makes the MCP server invoke @Tool/@Prompt/@Resource methods through the CDI 4.1 invoker API instead of reflection. The core MCP modules stay on Jakarta EE 10 / CDI 4.0.1.</description>

    <properties>
        <!--
            CDI 4.1 (Jakarta EE 11) is required ONLY by this optional module, for the
            jakarta.enterprise.invoke API. The version is pinned here, locally, instead of raising the
            inherited ${jakarta.enterprise.cdi-api.version} property (4.0.1), so that no other module -
            and no consumer of the core MCP artifacts - ever resolves CDI 4.1 transitively.
        -->
        <jakarta.enterprise.cdi-api.cdi41.version>4.1.0</jakarta.enterprise.cdi-api.cdi41.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-server</artifactId>
        </dependency>

        <!-- MCP annotations (@Tool, @Prompt, @Resource, @ResourceTemplate) scanned by the extension -->
        <dependency>
            <groupId>org.mcpjava</groupId>
            <artifactId>mcp-server-api</artifactId>
        </dependency>

        <!--
            Explicit local version override (NOT the inherited 4.0.1). 'provided' so it is never
            propagated to consumers: the CDI 4.1 runtime supplies these types.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.enterprise.cdi-api.cdi41.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.lang-model</artifactId>
            <version>${jakarta.enterprise.cdi-api.cdi41.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
