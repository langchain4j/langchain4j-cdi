<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.langchain4j.cdi</groupId>
        <artifactId>langchain4j-cdi-parent</artifactId>
        <version>1.4.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-cdi-jlink</artifactId>
    <name>Langchain4J CDI: Java module runtime-image tooling (vidocq)</name>
    <description>Opt-in tooling (profile jlink-vidocq) that prepares a fully-modular (Java module) dependency set for
        downstream consumers such as vidocq. It (1) enforces a permissive-license allow-list on the whole dependency
        closure, (2) patches the non-modular third-party jars with a generated module-info via ModiTect, and (3)
        verifies that the resulting module graph resolves on a strict module path. Producing the actual jlink image
        is a manual extension step (see JAVA_MODULE.md). This module is never deployed to Maven Central.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <gpg.skip>true</gpg.skip>
        <!-- Assembled module path used by the (3) verification step. -->
        <module-path.deps>${project.build.directory}/module-path</module-path.deps>
        <module-path.patched>${project.build.directory}/modules</module-path.patched>
        <!-- First-party roots that must resolve on the strict module path (mirrors JAVA_MODULE.md). -->
        <module-path.roots>dev.langchain4j.cdi.core,dev.langchain4j.cdi.portable,dev.langchain4j.cdi.el,dev.langchain4j.cdi.mp.config,dev.langchain4j.cdi.mp.faulttolerance,dev.langchain4j.cdi.mp.telemetry,dev.langchain4j.cdi.mcp.server,dev.langchain4j.cdi.mcp.portable</module-path.roots>
    </properties>

    <!--
        The module-path-friendly first-party set (traditional-server / jlink target). Excludes:
          - langchain4j-cdi-a2a          : automatic module only (upstream a2a-sdk package split),
          - langchain4j-cdi-build-compatible-ext : targets Quarkus/Helidon class-path builds, not the module path
            (it is split-free with core and would resolve fine; it is simply not part of the jlink target).
    -->
    <dependencies>
        <!--
            'provided' API jars of the first-party modules. Maven does not propagate the provided scope transitively,
            so they are re-declared here to land on the verified module path (the target runtime supplies them).
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.json.bind</groupId>
            <artifactId>jakarta.json.bind-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>${version.eclipse.microprofile.config}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.fault-tolerance</groupId>
            <artifactId>microprofile-fault-tolerance-api</artifactId>
            <version>${version.eclipse.microprofile.fault-tolerance}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-api</artifactId>
            <version>${version.eclipse.microprofile.telemetry}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <!-- First-party modules -->
        <dependency>
            <groupId>dev.langchain4j.cdi</groupId>
            <artifactId>langchain4j-cdi-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi</groupId>
            <artifactId>langchain4j-cdi-portable-ext</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi</groupId>
            <artifactId>langchain4j-cdi-el</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mp</groupId>
            <artifactId>langchain4j-cdi-config</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mp</groupId>
            <artifactId>langchain4j-cdi-fault-tolerance</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mp</groupId>
            <artifactId>langchain4j-cdi-telemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.cdi.mcp</groupId>
            <artifactId>langchain4j-cdi-mcp-portable-ext</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                (1) LICENSE GATE. Resolves the license of every dependency (transitive included) and fails the build
                if any of them is not on the permissive allow-list below. This guarantees we never patch and
                redistribute a third-party jar whose license does not allow it. Tune includedLicenses/licenseMerges
                against the generated target/generated-sources/license/THIRD-PARTY.txt on first run.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-permissive-licenses</id>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <failOnBlacklist>true</failOnBlacklist>
                            <failOnMissing>true</failOnMissing>
                            <includeTransitiveDependencies>true</includeTransitiveDependencies>
                            <!-- provided = supplied by the target runtime, never patched nor redistributed by us -->
                            <excludedScopes>test,provided</excludedScopes>
                            <!-- Permissive licenses we are allowed to patch & redistribute. -->
                            <includedLicenses>
                                <includedLicense>Apache License, Version 2.0</includedLicense>
                                <includedLicense>Apache-2.0</includedLicense>
                                <includedLicense>MIT License</includedLicense>
                                <includedLicense>MIT-0</includedLicense>
                                <includedLicense>BSD-2-Clause</includedLicense>
                                <includedLicense>BSD-3-Clause</includedLicense>
                                <includedLicense>Eclipse Public License - v 1.0</includedLicense>
                                <includedLicense>Eclipse Public License - v 2.0</includedLicense>
                                <includedLicense>EPL-1.0</includedLicense>
                                <includedLicense>EPL-2.0</includedLicense>
                                <includedLicense>EDL 1.0</includedLicense>
                            </includedLicenses>
                            <!-- Normalize the many spellings upstream projects use into the names above. -->
                            <licenseMerges>
                                <licenseMerge>Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache 2.0|Apache 2|Apache License 2.0|Apache-2.0|The Apache License, Version 2.0</licenseMerge>
                                <licenseMerge>MIT License|The MIT License|MIT</licenseMerge>
                                <licenseMerge>Eclipse Public License - v 2.0|EPL 2.0|Eclipse Public License v2.0|EPL-2.0</licenseMerge>
                                <licenseMerge>Eclipse Public License - v 1.0|EPL 1.0|EPL-1.0</licenseMerge>
                                <licenseMerge>BSD-3-Clause|The BSD 3-Clause License|BSD 3-Clause</licenseMerge>
                            </licenseMerges>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                (2) PATCH NON-MODULAR THIRD-PARTY JARS. ModiTect generates a module-info (requires/exports derived by
                jdeps) for each jar below and writes the modularized copy to target/modules. These are the jars in the
                module-path-friendly closure that ship neither a module-info nor an Automatic-Module-Name, so their
                automatic-module name would otherwise be an unstable, file-name-derived one. The chosen names match the
                'requires' already declared by the first-party module descriptors.

                To extend to a full jlink image, add every remaining automatic-module jar of your closure here as well
                (jlink cannot link automatic modules). List the closure with a jdeps 'list-deps' run over the
                assembled module path (see JAVA_MODULE.md for the exact command).
            -->
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
                <version>${moditect.version}</version>
                <executions>
                    <execution>
                        <id>patch-third-party</id>
                        <goals>
                            <goal>add-module-info</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <overwriteExistingFiles>true</overwriteExistingFiles>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <jdepsExtraArgs>
                                <arg>--multi-release</arg>
                                <arg>17</arg>
                            </jdepsExtraArgs>
                            <modules>
                                <module>
                                    <artifact>
                                        <groupId>dev.langchain4j</groupId>
                                        <artifactId>langchain4j</artifactId>
                                        <version>${dev.langchain4j.version}</version>
                                    </artifact>
                                    <moduleInfo>
                                        <name>langchain4j</name>
                                    </moduleInfo>
                                </module>
                                <module>
                                    <artifact>
                                        <groupId>dev.langchain4j</groupId>
                                        <artifactId>langchain4j-core</artifactId>
                                        <version>${dev.langchain4j.version}</version>
                                    </artifact>
                                    <moduleInfo>
                                        <name>langchain4j.core</name>
                                    </moduleInfo>
                                </module>
                                <module>
                                    <artifact>
                                        <groupId>dev.langchain4j</groupId>
                                        <artifactId>langchain4j-http-client</artifactId>
                                        <version>${dev.langchain4j.version}</version>
                                    </artifact>
                                    <moduleInfo>
                                        <name>langchain4j.http.client</name>
                                    </moduleInfo>
                                </module>
                                <module>
                                    <artifact>
                                        <groupId>dev.langchain4j</groupId>
                                        <artifactId>langchain4j-agentic</artifactId>
                                        <version>${dev.langchain4j.agentic.version}</version>
                                    </artifact>
                                    <moduleInfo>
                                        <name>langchain4j.agentic</name>
                                    </moduleInfo>
                                </module>
                                <module>
                                    <artifact>
                                        <groupId>org.mcpjava</groupId>
                                        <artifactId>mcp-server-api</artifactId>
                                        <version>${org.mcpjava.version}</version>
                                    </artifact>
                                    <moduleInfo>
                                        <name>mcp.server.api</name>
                                    </moduleInfo>
                                </module>
                            </modules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                (3) MODULE-GRAPH VERIFICATION. Assembles the whole dependency closure (provided Jakarta/MicroProfile
                APIs included) next to the ModiTect-patched jars and asks the JVM to resolve every first-party root on
                a strict module path. Any split package, missing 'requires' or unreadable module fails the build here,
                before downstream consumers hit it. The jars patched in (2) are excluded from the copy so that only
                their modularized copies are on the module path.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>assemble-module-path</id>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <outputDirectory>${module-path.deps}</outputDirectory>
                            <includeScope>compile</includeScope>
                            <excludeArtifactIds>langchain4j,langchain4j-core,langchain4j-http-client,langchain4j-agentic,mcp-server-api</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-plugin.version}</version>
                <executions>
                    <execution>
                        <id>verify-module-graph</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <!-- single 'module-path=' token: exec-maven-plugin gives a bare '-p' special treatment -->
                                <argument>--module-path=${module-path.patched}${path.separator}${module-path.deps}</argument>
                                <argument>--add-modules</argument>
                                <argument>${module-path.roots}</argument>
                                <argument>-version</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
